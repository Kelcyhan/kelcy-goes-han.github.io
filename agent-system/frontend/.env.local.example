# Copy this to `.env.local` to enable offline mock mode.
# In mock mode the dashboard renders entirely from fixtures in src/mocks/.
# Clerk auth is bypassed, /api/* is intercepted, WebSockets are silently stubbed.

VITE_USE_MOCKS=1

# Required only when VITE_USE_MOCKS is unset / 0 (real backend mode).
# Leave commented out for design work.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
