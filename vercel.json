{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/projects/:path*", "destination": "/index.html" },
    { "source": "/AISpeakingLab", "destination": "/index.html" },
    { "source": "/AISpeakingLab/", "destination": "/index.html" },
    { "source": "/AgentSystem", "destination": "/index.html" },
    { "source": "/AgentSystem/", "destination": "/index.html" },
    { "source": "/DiscussAgain", "destination": "/index.html" },
    { "source": "/DiscussAgain/", "destination": "/index.html" },
    { "source": "/MetacogReef", "destination": "/index.html" },
    { "source": "/MetacogReef/", "destination": "/index.html" },
    { "source": "/PointFit", "destination": "/index.html" },
    { "source": "/PointFit/", "destination": "/index.html" },
    { "source": "/Puri", "destination": "/index.html" },
    { "source": "/Puri/", "destination": "/index.html" },
    { "source": "/SupplyNet", "destination": "/index.html" },
    { "source": "/SupplyNet/", "destination": "/index.html" },
    { "source": "/Swarm", "destination": "/index.html" },
    { "source": "/Swarm/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/demos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
